# These authentication flows should not be used in production 
# substitute with your own values.
VIYA_SERVER= 
VIYA_USER= 
VIYA_PASSWORD= 
VIYA_CLIENTID=
VIYA_CLIENTSECRET=
LOANURL=
DEBUG=none
# DEBUG=tools,read,logonpayload,deletesession,mcpserver

# Preferred:  use "sas-viya auth loginCode" to create auth token and refresh token
# This will work just like all sas-viya cli commands  - it will create a token using the refresh token

# As currently configured this option will not work when the mcp server is running in docker
# To fix this have to add a file mount and some other changes
USETOKEN=TRUE


